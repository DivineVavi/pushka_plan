# Safe defaults for a credential-free local run.
# Copy to .env ONLY when configuring your own MAX bot; never commit secrets.
CULTURE_SOURCE_MODE=snapshot
CATALOG_SNAPSHOT_PATH=/app/data/catalog-snapshot.sqlite3
PUSHKA_BIND_IP=127.0.0.1
PUSHKA_HOST_PORT=8000

# Real MAX: own bot token, webhook secret and externally provided HTTPS origin.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEB_APP_ID=
PUBLIC_URL=

# Optional admin and browser-demo cookie signature override.
ADMIN_TOKEN=
DEMO_COOKIE_KEY=

# Optional permissioned live collection; NOT needed for snapshot/demo modes.
CULTURE_PROXY_HOST=pool.proxy.market
CULTURE_PROXY_PORT=10000
CULTURE_PROXY_USER=
CULTURE_PROXY_PASSWORD=

# Optional PRO.Культура alternative; NOT needed for the main scenario.
PRO_API_KEY=
PRO_SNAPSHOT_PATH=
PRO_LOCALE_IDS=
