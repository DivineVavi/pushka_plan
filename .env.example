# Безопасные значения для локального запуска; секреты храните только в .env.
CATALOG_SNAPSHOT_PATH=/app/data/catalog-snapshot.sqlite3
PUSHKA_BIND_IP=127.0.0.1
PUSHKA_HOST_PORT=8000

# MAX: токен и секрет обязательны для подключения бота; PUBLIC_URL должен быть HTTPS.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
PUBLIC_URL=
# Историческое имя переменной; значение — username бота для кнопки open_app.
MAX_WEB_APP_ID=t99_hakaton_max_bot

# Необязательные ключи администратора и подписи браузерной cookie.
ADMIN_TOKEN=
DEMO_COOKIE_KEY=
